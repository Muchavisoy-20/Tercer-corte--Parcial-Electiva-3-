# Configuración del Servidor
PORT=8080

# Configuración de Base de Datos (MySQL/MariaDB)
# Usar 127.0.0.1 para evitar problemas con IPv6 en Windows
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=tienda_virtual

# Seguridad
# Cambiar esto por una clave secreta fuerte en producción
JWT_SECRET=clave_secreta_para_desarrollo_123
